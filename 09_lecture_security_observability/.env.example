# Ключ LLM. Безкоштовний: https://aistudio.google.com/apikey
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Будь-який OpenAI-сумісний шлюз замість Google: розкоментуйте LLM_PROVIDER.
# LLM_PROVIDER=openai
OPENAI_BASE_URL=
OPENAI_API_KEY=
LLM_MODEL=

# БОНУС, тільки для s4b_langfuse.py. Локальний Langfuse: cd langfuse_docker &&
# docker compose up -d — ключі нижче він створює при першому старті сам.
# Саме LANGFUSE_HOST, а не LANGFUSE_BASE_URL: іншу назву SDK не читає
# і мовчки йде в хмару, де ці ключі не діють (401).
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=pk-lf-shopbot-demo-0000
LANGFUSE_SECRET_KEY=sk-lf-shopbot-demo-0000

# БОНУС, тільки для s4c_langsmith.py. Безкоштовний ключ:
# https://smith.langchain.com → Settings → API Keys
LANGSMITH_API_KEY=
# US-акаунт — рядок нижче; європейський — https://eu.api.smith.langchain.com
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# 1 — підтверджувати дії агента руками (s3, s4, s4b: HITL-гейт питає в консолі).
DEMO_INTERACTIVE=0

LLM_PROVIDER=google
# LLM_PROVIDER=openai

