# Ключ LLM. Безкоштовний: https://aistudio.google.com/apikey
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Будь-який OpenAI-сумісний шлюз замість Google: розкоментуйте LLM_PROVIDER.
# LLM_PROVIDER=openai
OPENAI_BASE_URL=
OPENAI_API_KEY=
LLM_MODEL=

# Крок 7: трасування в LangSmith. Без цих змінних усе працює так само,
# просто нікуди не відправляється — код міняти не треба.
# Ключ безкоштовний: https://smith.langchain.com → Settings → API Keys
LANGSMITH_API_KEY=lsv2_pt_...
LANGSMITH_PROJECT=mas-mcp-practicum
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_TRACING=true

LLM_PROVIDER=google
# LLM_PROVIDER=openai


# Вартість прогону у LangSmith. Публічні моделі він рахує сам; моделі за
# корпоративним шлюзом — ні, бо в трейсі вони підписані провайдером "openai".
# Задайте ціну в доларах за 1M токенів — крок 7 зареєструє її один раз.
LLM_PRICE_INPUT=0.19
LLM_PRICE_OUTPUT=0.51
